# MTProxy configuration
# Copy to .env and source it before running: source .env

# (Required) Comma-separated secrets.
# Format: [name:]<secret>
#
#   dd-secret (obfuscated2):
#     SECRETS=alice:dd0102030405060708090a0b0c0d0e0f
#
#   ee-secret (fake-TLS, domain=google.com → hex 676f6f676c652e636f6d):
#     SECRETS=bob:ee0102030405060708090a0b0c0d0e0f676f6f676c652e636f6d
#
#   Multiple secrets:
#     SECRETS=alice:dd0102030405060708090a0b0c0d0e0f,bob:ee0102030405060708090a0b0c0d0e0f676f6f676c652e636f6d
#
# Generate a random 16-byte secret:
#   openssl rand -hex 16
SECRETS=myuser:dd$(openssl rand -hex 16)

# Listen address (default: 0.0.0.0)
BIND_ADDR=0.0.0.0

# Listen port (default: 443, requires root or CAP_NET_BIND_SERVICE)
PORT=443

# Idle connection timeout in seconds (default: 120)
TIMEOUT_SEC=120

# Stats HTTP server address (default: :8080)
# GET /stats  — metrics
# GET /health — liveness probe
STATS_ADDR=:8080
